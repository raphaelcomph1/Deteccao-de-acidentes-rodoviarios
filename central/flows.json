                "26ca721460b836cb"
            ]
        ]
    },
    {
        "id": "162a45344649207a",
        "type": "function",
        "z": "0acef594f62d9032",
        "name": "Registrar ACK",
        "func": "// ACK do ESP32: ENVIADO -> RECEBIDO -> APLICADO (só APLICADO conta como execução confirmada)\nconst p = msg.payload;\nif (!p || p.tipo_msg !== \"ACK\" || !p.command_id) return null;\nif (p.duplicado) return null;                      // ACK de comando duplicado não muda o status\nconst cmds = flow.get(\"comandos\", \"file\") || {};\nconst c = cmds[p.command_id];\nif (!c) { node.warn(\"ACK de comando desconhecido: \" + p.command_id); return null; }\nconst agora = new Date().toISOString();\nif (p.fase === \"RECEBIDO\" && !c.recebido_em) c.recebido_em = agora;\nif (p.fase === \"APLICADO\") { c.aplicado_em = agora; c.recebido_em = c.recebido_em || agora; }\nc.status = c.aplicado_em ? \"APLICADO\" : c.recebido_em ? \"RECEBIDO\" : \"ENVIADO\";\nflow.set(\"comandos\", cmds, \"file\");\nreturn { payload: \"refresh\" };\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 480,
        "y": 810,
        "wires": [
            [
                "f178cce4a8186f34"
            ]
        ]
    },
    {
        "id": "f178cce4a8186f34",
        "type": "function",
        "z": "0acef594f62d9032",
        "name": "Montar tabela de comandos",
        "func": "// Tabela de comandos: enviado × recebido × aplicado\nconst cmds = flow.get(\"comandos\", \"file\") || {};\nconst fmt = d => d ? new Date(d).toLocaleTimeString(\"pt-BR\", { timeZone: \"America/Sao_Paulo\" }) : \"—\";\nmsg.payload = Object.values(cmds)\n    .sort((a, b) => (b.enviado_em || \"\").localeCompare(a.enviado_em || \"\"))\n    .map(c => ({\n        command_id: c.command_id, acao: c.acao, event_id: c.event_id ?? \"—\",\n        estado_alvo: c.estado_alvo, enviado: fmt(c.enviado_em),\n        recebido: fmt(c.recebido_em), aplicado: fmt(c.aplicado_em), status: c.status\n    }));\nreturn msg;\n",
        "outputs": 1,
