    {
        "id": "e6b1c765052f3a8f",
        "type": "function",
        "z": "0acef594f62d9032",
        "name": "Atualizar conexão",
        "func": "// Alimenta o estado da conexão com o ESP32 (heartbeat, LWT, ACK, SYNC). Sem saída.\nconst p = msg.payload;\nif (!p || typeof p !== \"object\") return null;\nconst esp = flow.get(\"esp32\") || { online: false, ultimo_contato: null, motivo: \"sem contato\" };\nif (p.tipo_msg === \"LWT\") {\n    if (p.online === false) { esp.online = false; esp.motivo = \"LWT\"; }          // vale mesmo se retido\n    else if (!msg.retain)   { esp.online = true; esp.ultimo_contato = Date.now(); }\n} else if (!msg.retain) {                                                        // retido = mensagem velha\n    esp.online = true;\n    esp.ultimo_contato = Date.now();\n}\nflow.set(\"esp32\", esp);\nreturn null;\n",
        "outputs": 0,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 480,
        "y": 710,
        "wires": []
    },
    {
        "id": "81c08b9d7bec6f77",
        "type": "function",
        "z": "0acef594f62d9032",
        "name": "Tratar SYNC",
        "func": "// Quando o ESP32 manda SYNC, responde com o comando SINCRONIZAR e o estado atual\nconst p = msg.payload;\nif (!p || p.tipo_msg !== \"SYNC\") return null;\nif (Date.now() - (flow.get(\"ultimo_sync\") || 0) < 2000) return null;     // limita a taxa\nflow.set(\"ultimo_sync\", Date.now());\nconst v = Object.values(flow.get(\"ocorrencias\", \"file\") || {});\nconst ativo = v.find(o => o.estado === \"CONFIRMADO\") || v.find(o => o.estado === \"SUSPEITA\");\nreturn { cmd: { event_id: ativo ? ativo.event_id : null, acao: \"SINCRONIZAR\" } };\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 480,
        "y": 760,
        "wires": [
