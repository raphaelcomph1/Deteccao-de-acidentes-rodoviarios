    {
        "id": "f5383b4a131ca5a0",
        "type": "function",
        "z": "c1acac5a23e5b45f",
        "name": "function 2",
        "func": "let ev = msg.payload;\nif (typeof ev === \"string\") {\n  try { ev = JSON.parse(ev); }\n  catch (e) { node.warn(\"JSON inválido: \" + msg.payload); return null; }\n}\nflow.set(\"evento_atual\", ev);\nnode.warn(\"evento_atual gravado: \" + JSON.stringify(ev));\nreturn null;",
