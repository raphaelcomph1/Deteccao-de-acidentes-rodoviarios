    {
        "id": "fc590ea3fe51b8d4",
        "type": "function",
        "z": "0acef594f62d9032",
        "name": "interpretar ACK",
        "func": "// Texto do último ACK (HEARTBEAT, SYNC e LWT são tratados em outros nós)\nconst p = msg.payload;\nif (!p || p.tipo_msg !== \"ACK\") return null;\n\nif (p.duplicado) {\n  msg.payload = `Duplicado, ignorado pelo ESP32: ${p.command_id}`;\n} else if (p.fase === \"APLICADO\") {\n  msg.payload = `APLICADO pelo ESP32: ${p.command_id} (${p.estado})`;\n} else {\n  msg.payload = `RECEBIDO pelo ESP32 (ainda não aplicado): ${p.command_id}`;\n}\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
