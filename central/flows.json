    {
        "id": "782119bfa790212c",
        "type": "function",
        "z": "0acef594f62d9032",
        "name": "Exibir conexão",
        "func": "// A cada 1 s: mostra conectado/desconectado (timeout 15 s) e o estado global.\nconst esp = flow.get(\"esp32\") || { online: false, ultimo_contato: null, motivo: \"sem contato\" };\nif (esp.online && Date.now() - esp.ultimo_contato > 15000) {\n    esp.online = false; esp.motivo = \"timeout 15 s\"; flow.set(\"esp32\", esp);\n}\nconst hora = esp.ultimo_contato\n    ? new Date(esp.ultimo_contato).toLocaleTimeString(\"pt-BR\", { timeZone: \"America/Sao_Paulo\" }) : \"—\";\nconst t1 = (esp.online ? \"🟢 CONECTADO\" : \"🔴 DESCONECTADO\") + \" | último contato: \" + hora + (esp.online ? \"\" : \" (\" + esp.motivo + \")\");\n\nconst v = Object.values(flow.get(\"ocorrencias\", \"file\") || {});\nconst nc = v.filter(o => o.estado === \"CONFIRMADO\").length;\nconst ns = v.filter(o => o.estado === \"SUSPEITA\").length;\nconst eg = nc ? \"CONFIRMADO\" : ns ? \"SUSPEITA\" : \"NORMAL\";\nconst t2 = eg + \" — \" + nc + \" confirmada(s), \" + ns + \" suspeita(s)\";\nreturn [{ payload: t1 }, { payload: t2 }];\n",
        "outputs": 2,
        "timeout": 0,
