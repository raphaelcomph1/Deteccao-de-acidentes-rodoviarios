    {
        "id": "14d405c911289c21",
        "type": "function",
        "z": "c1acac5a23e5b45f",
        "name": "montar comando (contrato v0.2)",
        "func": "// Monta o comando no formato do contrato v0.2 (docs/contrato_mqtt.md, secao 5.2)\nconst estados = {\n  CONFIRMAR: \"CONFIRMADO\",\n  REJEITAR:  \"NORMAL\",\n  ENCERRAR:  \"NORMAL\"\n};\n\nconst acao = msg.payload;\nif (!(acao in estados)) { node.warn(\"Acao desconhecida: \" + acao); return null; }\n\nconst ev = flow.get(\"evento_atual\");\nif (!ev || !ev.event_id) { node.warn(\"Nenhum evento selecionado\"); return null; }\n\n// seq = horario da central em ms, sempre crescente (nao zera se o Node-RED reiniciar)\nconst ultimo = flow.get(\"ultimo_seq\") || 0;\nconst seq = Math.max(Date.now(), ultimo + 1);\nflow.set(\"ultimo_seq\", seq);\n\n// command_id = cmd-AAAAMMDDTHHMMSS-<4 hex>\nconst d = new Date();\nconst p = n => String(n).padStart(2, \"0\");\nconst carimbo = `${d.getFullYear()}${p(d.getMonth() + 1)}${p(d.getDate())}T${p(d.getHours())}${p(d.getMinutes())}${p(d.getSeconds())}`;\nconst hex = Math.floor(Math.random() * 65536).toString(16).padStart(4, \"0\");\n\nmsg.payload = {\n  v: 1,\n  command_id: `cmd-${carimbo}-${hex}`,\n  seq: seq,\n  event_id: ev.event_id,\n  acao: acao,\n  estado_alvo: estados[acao]\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 720,
        "y": 380,
        "wires": [
            [
                "7e2bc156f29c4019",
                "244c8ad33626f4ed",
                "edb25472d58e173d"
            ]
        ]
    },
