    {
        "id": "fbc2906f664aa6f5",
        "type": "function",
        "z": "0acef594f62d9032",
        "name": "Registrar evento",
        "func": "// Registra/atualiza a ocorrência pelo event_id (idempotente) e dispara SUSPEITA para eventos novos.\nlet ev = msg.payload;\nif (typeof ev === \"string\") { try { ev = JSON.parse(ev); } catch (e) { node.warn(\"JSON inválido em eventos\"); return null; } }\nif (!ev || typeof ev !== \"object\" || !ev.event_id) { node.warn(\"Evento sem event_id\"); return null; }\nif (ev.tipo === \"SEM_ACIDENTE\") return null;          // não vira ocorrência\n\nconst oc  = flow.get(\"ocorrencias\", \"file\") || {};\nconst old = oc[ev.event_id];\nconst rev = Number(ev.revisao ?? 1);\n\nif (old && [\"ENCERRADO\", \"REJEITADO\"].includes(old.estado)) {   // terminais: nunca reabrem\n    node.status({ fill: \"grey\", shape: \"ring\", text: \"ignorado (terminal) \" + ev.event_id });\n    return null;\n}\nif (old && rev <= old.revisao) {                                // duplicata ou revisão antiga\n    node.status({ fill: \"grey\", shape: \"ring\", text: \"duplicata \" + ev.event_id });\n    return null;\n}\n\nconst conf = (ev.confianca && typeof ev.confianca === \"object\")\n    ? ev.confianca\n    : { valor: ev.confianca, nivel: ev.nivel_confianca };   // contrato v0.2: confianca (0-1) + nivel_confianca\nconst agora = new Date().toISOString();\noc[ev.event_id] = {\n    event_id: ev.event_id, revisao: rev,\n    timestamp: ev.timestamp, camera_id: ev.camera_id, local: ev.local,\n    tipo: ev.tipo, confianca: conf, indicadores: ev.indicadores,\n    recomendacao: ev.recomendacao, evidencia: ev.evidencia,\n    recebido_em: old ? old.recebido_em : agora, atualizado_em: agora,\n    estado: old ? old.estado : \"SUSPEITA\"        // a central é dona do estado\n};\nflow.set(\"ocorrencias\", oc, \"file\");\nnode.status({ fill: \"green\", shape: \"dot\", text: (old ? \"atualizado \" : \"novo \") + ev.event_id + \" r\" + rev });\n\nconst novo = !old;\nreturn [{ payload: \"refresh\" },\n        novo ? { cmd: { event_id: ev.event_id, acao: \"SUSPEITA\" } } : null];\n",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 440,
        "y": 250,
        "wires": [
            [
                "75c1762a0fc7e106"
            ],
            [
                "26ca721460b836cb"
            ]
        ]
    },
    {
        "id": "75c1762a0fc7e106",
        "type": "function",
        "z": "0acef594f62d9032",
        "name": "Montar tabela de ocorrências",
        "func": "// Monta as linhas da tabela de ocorrências (mais recentes primeiro)\n// Justificativa da matriz de recomendação (docs/contrato_mqtt.md, seção 4) - regras fictícias, não é protocolo médico\nconst MATRIZ = {\n    R1: \"Acidente detectado sem indicador adicional de risco: solicitar avaliação da equipe operacional\",\n    R2: \"Colisão com veículo parado na pista (indicador de risco): sugerir ambulância na simulação\",\n    R3: \"Possível atropelamento: sugerir avaliação prioritária e recurso adicional de resgate\",\n    R4: \"Imagem ambígua ou confiança média: revisão do operador sem concluir tipo ou gravidade\"\n};\nconst oc = flow.get(\"ocorrencias\", \"file\") || {};\nconst fmt = d => {\n    if (!d) return \"—\";\n    const t = new Date(d);\n    return isNaN(t) ? String(d) : t.toLocaleString(\"pt-BR\", { timeZone: \"America/Sao_Paulo\" });\n};\nmsg.payload = Object.values(oc)\n    .sort((a, b) => (b.recebido_em || \"\").localeCompare(a.recebido_em || \"\"))\n    .map(o => ({\n        event_id: o.event_id,\n        rev: o.revisao,\n        horario: fmt(o.timestamp),\n        tipo: o.tipo,\n        confianca: (o.confianca && o.confianca.valor != null && !isNaN(o.confianca.valor))\n            ? Math.round(o.confianca.valor * 100) + \"% (\" + (o.confianca.nivel || \"-\") + \")\" : \"—\",\n        local: o.local || \"—\",\n        regra: o.recomendacao?.regra || \"—\",\n        recurso: o.recomendacao?.recurso || \"—\",\n        justificativa: o.recomendacao?.justificativa || MATRIZ[o.recomendacao?.regra] || \"—\",\n        evidencia: o.evidencia\n            ? (o.evidencia.video || \"?\") + \" @ \" + (o.evidencia.tempo_s ?? o.evidencia.instante_s ?? \"?\") + \" s\"\n            : \"—\",\n        estado: o.estado\n    }));\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 740,
        "y": 250,
        "wires": [
            [
                "676c528bd53d9642"
            ]
        ]
    },
