        "id": "26ca721460b836cb",
        "type": "function",
        "z": "0acef594f62d9032",
        "name": "Montar comando",
        "func": "// Único ponto de criação de comandos (contrato v0.2): SUSPEITA, CONFIRMAR, REJEITAR, ENCERRAR, SINCRONIZAR.\n// entrada: msg.cmd = { event_id, acao }\nconst c = msg.cmd;\nif (!c || !c.acao) return null;\n\n// estado_alvo considera TODAS as ocorrências: CONFIRMADO > SUSPEITA > NORMAL\nconst ocs = Object.values(flow.get(\"ocorrencias\", \"file\") || {});\nconst estado_alvo = ocs.some(o => o.estado === \"CONFIRMADO\") ? \"CONFIRMADO\"\n                  : ocs.some(o => o.estado === \"SUSPEITA\")   ? \"SUSPEITA\" : \"NORMAL\";\n\n// seq = horário em ms, sempre crescente (não zera se reiniciar)\nconst ultimo = flow.get(\"ultimo_seq\", \"file\") || 0;\nconst seq = Math.max(Date.now(), ultimo + 1);\nflow.set(\"ultimo_seq\", seq, \"file\");\n\n// command_id = cmd-AAAAMMDDTHHMMSS-<4 hex>\nconst d = new Date();\nconst p = n => String(n).padStart(2, \"0\");\nconst carimbo = `${d.getFullYear()}${p(d.getMonth() + 1)}${p(d.getDate())}T${p(d.getHours())}${p(d.getMinutes())}${p(d.getSeconds())}`;\nconst hex = Math.floor(Math.random() * 65536).toString(16).padStart(4, \"0\");\n\nconst cmd = { v: 1, command_id: `cmd-${carimbo}-${hex}`, seq: seq,\n              event_id: c.event_id ?? null, acao: c.acao, estado_alvo: estado_alvo };\n\n// registro local para acompanhar ENVIADO → RECEBIDO → APLICADO\nconst cmds = flow.get(\"comandos\", \"file\") || {};\ncmds[cmd.command_id] = { ...cmd, enviado_em: d.toISOString(), status: \"ENVIADO\" };\nconst ids = Object.keys(cmds);\nif (ids.length > 50) ids.slice(0, ids.length - 50).forEach(k => delete cmds[k]);\nflow.set(\"comandos\", cmds, \"file\");\n\ndelete msg.cmd;\nmsg.payload = cmd;\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
