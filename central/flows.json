    {
        "id": "3ab8193ec07bf2ab",
        "type": "function",
        "z": "c1acac5a23e5b45f",
        "name": "interpretar ACK",
        "func": "// So ACKs interessam aqui (HEARTBEAT, SYNC e LWT sao tratados em outro lugar)\nconst p = msg.payload;\nif (!p || p.tipo_msg !== \"ACK\") return null;\n\nif (p.duplicado) {\n  msg.payload = `Duplicado, ignorado pelo ESP32: ${p.command_id}`;\n} else if (p.fase === \"APLICADO\") {\n  msg.payload = `Aplicado pelo ESP32: ${p.command_id} (${p.estado})`;\n} else {\n  msg.payload = `Recebido pelo ESP32: ${p.command_id}`;\n}\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 840,
        "y": 620,
