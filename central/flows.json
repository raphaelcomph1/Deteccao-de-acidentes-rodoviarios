        "name": "Exportar dados",
        "func": "// GET /historico?tipo=decisoes|ocorrencias|comandos&fmt=csv|json\nconst q = (msg.req && msg.req.query) || {};\nconst tipo = String(q.tipo || \"decisoes\").toLowerCase();\nconst fmt = String(q.fmt || \"csv\").toLowerCase();\nlet dados, nome, base = [];\nif (tipo === \"ocorrencias\")      { dados = Object.values(flow.get(\"ocorrencias\", \"file\") || {}); nome = \"ocorrencias\"; }\nelse if (tipo === \"comandos\")    { dados = Object.values(flow.get(\"comandos\", \"file\") || {});    nome = \"comandos\"; }\nelse {\n    dados = flow.get(\"historico\", \"file\") || [];\n    nome = \"historico_decisoes\";\n    base = [\"ts\", \"event_id\", \"acao\", \"estado_anterior\", \"estado_novo\", \"operador\"];\n}\nconst stamp = new Date().toISOString().slice(0, 19).replace(/[:T]/g, \"-\");\nif (fmt === \"json\") {\n    msg.payload = JSON.stringify(dados, null, 2);\n    msg.headers = { \"Content-Type\": \"application/json; charset=utf-8\",\n                    \"Content-Disposition\": `attachment; filename=${nome}_${stamp}.json` };\n} else {\n    const cols = [...new Set(base.concat(dados.flatMap(o => Object.keys(o))))];\n    const esc = v => '\"' + String((v !== null && typeof v === \"object\") ? JSON.stringify(v) : (v ?? \"\")).replace(/\"/g, '\"\"') + '\"';\n    msg.payload = \"\\ufeff\" + [cols.map(esc).join(\",\")].concat(dados.map(o => cols.map(c => esc(o[c])).join(\",\"))).join(\"\\r\\n\");\n    msg.headers = { \"Content-Type\": \"text/csv; charset=utf-8\",\n                    \"Content-Disposition\": `attachment; filename=${nome}_${stamp}.csv` };\n}\nmsg.statusCode = 200;\nreturn msg;\n",
