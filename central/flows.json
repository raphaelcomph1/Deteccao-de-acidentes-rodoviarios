    {
        "id": "a28cf37a81693095",
        "type": "function",
        "z": "0acef594f62d9032",
        "name": "Aplicar decisão",
        "func": "// Botões CONFIRMAR / REJEITAR / ENCERRAR: valida, muda o estado, grava o histórico e dispara o comando.\nconst REGRAS = {\n    CONFIRMAR: { de: [\"SUSPEITA\"],   para: \"CONFIRMADO\" },\n    REJEITAR:  { de: [\"SUSPEITA\"],   para: \"REJEITADO\"  },\n    ENCERRAR:  { de: [\"CONFIRMADO\"], para: \"ENCERRADO\"  }\n};\nconst acao = msg.payload;\nconst r = REGRAS[acao];\nif (!r) { node.warn(\"Ação desconhecida: \" + acao); return null; }\nconst aviso = t => [null, null, { payload: t }];\n\nconst sel = flow.get(\"evento_atual\");\nif (!sel || !sel.event_id) return aviso(\"⚠ Selecione uma ocorrência na tabela\");\nconst oc = flow.get(\"ocorrencias\", \"file\") || {};\nconst ev = oc[sel.event_id];\nif (!ev) return aviso(\"⚠ Ocorrência não encontrada\");\nif (!r.de.includes(ev.estado)) return aviso(\"⚠ \" + acao + \" não permitido: ocorrência está \" + ev.estado);\n\nconst anterior = ev.estado;\nconst agora = new Date().toISOString();\nev.estado = r.para;\nev.atualizado_em = agora;\nflow.set(\"ocorrencias\", oc, \"file\");\n\nconst h = flow.get(\"historico\", \"file\") || [];\nh.push({ ts: agora, event_id: ev.event_id, acao: acao,\n         estado_anterior: anterior, estado_novo: ev.estado, operador: \"operador-dashboard\" });\nflow.set(\"historico\", h, \"file\");\n\nreturn [{ cmd: { event_id: ev.event_id, acao: acao } },\n        { payload: \"refresh\" },\n        { payload: \"✔ \" + acao + \" registrado em \" + ev.event_id + \" (\" + anterior + \" → \" + ev.estado + \")\" }];\n",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 440,
        "y": 480,
        "wires": [
