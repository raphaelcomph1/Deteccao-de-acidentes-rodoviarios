        "id": "9eeaa2211bbff0ad",
        "type": "function",
        "z": "0acef594f62d9032",
        "name": "Selecionar evento",
        "func": "// Clique numa linha da tabela = seleciona a ocorrência (substitui o inject de teste)\nconst p = msg.payload;\nconst row = Array.isArray(p) ? p[0] : p;\nconst id = row && row.event_id;\nif (!id) return null;\nflow.set(\"evento_atual\", { event_id: id });\nconst ev = (flow.get(\"ocorrencias\", \"file\") || {})[id];\nmsg.payload = \"Selecionada: \" + id + (ev ? \" — \" + ev.tipo + \" (\" + ev.estado + \")\" : \"\");\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
